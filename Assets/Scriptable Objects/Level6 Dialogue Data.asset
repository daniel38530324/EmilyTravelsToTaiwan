  m_Script: {fileID: 11500000, guid: ee997f4913f2656478bf5718942019c2, type: 3}
  m_Name: Level6 Dialogue Data
  m_EditorClassIdentifier: 
  Dialogues:
  - "\u827E\u871C\u8389\uFF0C\u9019\u662F\u5E6B\u59B3\u5E36\u56DE\u4F86\u7684\u8C46\u6F3F\u548C\u86CB\u9905\u3002\u59B3\u665A\u9910\u53EA\u5403\u9019\u4E9B\u55CE?"
  - "\u6211\u4E0D\u592A\u9913,\u9019\u4E9B\u5920\u4E86\u3002\u4F60\u8CB7\u4E86\u4EC0\u9EBC? "
  - "\u96DE\u817F\u4FBF\u7576,\u4F60\u770B,\u5F88\u8C50\u5BCC\u5427? "
  - "\u805E\u8D77\u4F86\u5F88\u9999,\u6539\u5929\u6211\u5403\u5403\u770B\u3002 "
  - "\u807D\u8AAA\u59B3\u5BB6\u96E2\u5B78\u6821\u4E0D\u9060,\u4F60\u6BCF\u5929\u600E\u9EBC\u4F86\u4E0A\u5B78? "
  - "\u6211\u5E73\u5E38\u642D\u6377\u904B\u3002\u4E0A\u5B78\u5FEB\u9072\u5230\u4E86,\u6211\u624D\u642D\u8A08\u7A0B\u8ECA\u3002 "
  - "\u59B3\u642D\u54EA\u4E00\u689D\u8DEF\u7DDA?\u8981\u8F49\u8ECA\u55CE? "
  - "\u6211\u642D\u7DA0\u7DDA,\u642D\u56DB\u7AD9\u5C31\u5230\u5B78\u6821\u4E86,\u4E0D\u5FC5\u8F49\u8ECA\u3002\u6211\u975E\u5E38\u559C\u6B61\u81FA\u7063\u7684\u6377\u904B,\u4E0D\u4F46\u73ED\u6B21\u591A,\u800C\u4E14\u8ECA\u7968\u4E0D\u7B97\u8CB4\u3002 "
  - "\u662F\u554A!\u5927\u5BB6\u90FD\u8A8D\u70BA\u6377\u904B\u53C8\u5FEB\u53C8\u65B9\u4FBF\u3002\u5982\u679C\u4F60\u6703\u9A0E\u81EA\u884C\u8ECA\u7684\u8A71,\u4E5F\u53EF\u4EE5\u9A0E\u81EA\u884C\u8ECA\u4F86\u3002 "
  - "\u9A0E\u81EA\u884C\u8ECA?\u53EF\u662F\u6211\u6C92\u6709\u81EA\u884C\u8ECA\u554A! "
  - "\u59B3\u5728\u6377\u904B\u7AD9\u5916\u9762\u770B\u5230\u5F88\u591A\u81EA\u884C\u8ECA\u5427?\u90A3\u662F\u8AB0\u90FD\u53EF\u4EE5\u79DF\u7684,\u5F88\u53D7\u6B61\u8FCE\u3002 "
  - "\u4F60\u8AAA\u7684\u662F\u90A3\u4E9B\u9EC3\u8272\u7684\u81EA\u884C\u8ECA?\u96E3\u602A\u5F88\u591A\u4EBA\u4E00\u51FA\u6377\u904B\u7AD9\u5C31\u53BB\u9A0E\u8ECA,
    \u6211\u9084\u89BA\u5F97\u5F88\u5947\u602A\u5462! "
  - "\u7528\u60A0\u904A\u5361\u5C31\u53EF\u4EE5\u79DF,\u4F60\u660E\u5929\u53EF\u4EE5\u8A66\u8A66\u770B\u3002 "
  - "\u9019\u88E1\u6709\u5F88\u591A\u6C7D\u8ECA\u3001\u6469\u6258\u8ECA,\u6211\u89BA\u5F97\u9A0E\u81EA\u884C\u8ECA\u6709\u9EDE\u5371\u96AA\u3002 "
  - "\u53EA\u8981\u59B3\u6162\u6162\u5730\u9A0E,\u6CE8\u610F\u65C1\u908A\u7684\u6469\u6258\u8ECA,\u5C31\u4E0D\u6703\u6709\u554F\u984C\u3002 "
  - "\u6377\u904B\u5F88\u65B9\u4FBF,\u70BA\u4EC0\u9EBC\u9084\u6709\u90A3\u9EBC\u591A\u4EBA\u9A0E\u6469\u6258\u8ECA? "
  - "\u6469\u6258\u8ECA\u66F4\u65B9\u4FBF\u554A!\u60F3\u53BB\u54EA\u88E1\u5C31\u53BB\u54EA\u88E1,\u5B8C\u5168\u4E0D\u5FC5\u8D70\u8DEF\u3002\u5728\u81FA\u7063,
    \u6469\u6258\u8ECA\u662F\u6700\u666E\u904D\u7684\u4EA4\u901A\u5DE5\u5177\u3002 "
  - "\u9019\u500B\u60C5\u5F62\u8DDF\u5927\u90E8\u5206\u7F8E\u570B\u4EBA\u51FA\u9580\u5E38\u958B\u8ECA\u4E00\u6A23,\u90FD\u662F\u70BA\u4E86\u65B9\u4FBF\u3002"
  Highlights:
  - "\u8C46\u6F3F"
  - "\u86CB\u9905"
