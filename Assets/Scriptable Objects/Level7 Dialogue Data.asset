  m_Script: {fileID: 11500000, guid: ee997f4913f2656478bf5718942019c2, type: 3}
  m_Name: Level7 Dialogue Data
  m_EditorClassIdentifier: 
  Dialogues:
  - "\u6B23\u6021,\u6211\u6536\u5230\u9EC3\u5C0F\u59D0\u7684\u559C\u5E16,\u5979\u8ACB\u6211\u53C3\u52A0\u5979\u7684\u7D50\u5A5A\u5178\u79AE\u3002"
  - "\u6211\u4E5F\u6536\u5230\u4E86\u3002\u4F60\u6703\u53BB\u559D\u559C\u9152\u5427?"
  - "\u6211\u5F9E\u4F86\u6C92\u53C3\u52A0\u904E\u83EF\u4EBA\u7684\u5A5A\u79AE,\u7576\u7136\u6703\u53BB\u3002\u6211\u61C9\u8A72\u9001\u79AE\u7269\u9084\u662F\u9001\u7D05\u5305\u5462?"
  - "\u9001\u79AE\u7269\u53EF\u4EE5,\u4E0D\u904E\u5927\u90E8\u5206\u7684\u4EBA\u6703\u9001\u7D05\u5305\u3002"
  - "\u90A3\u9EBC\u6211\u4E5F\u9001\u7D05\u5305\u5427\u3002\u6211\u807D\u8AAA\u9001\u7D05\u5305\u8981\u6CE8\u610F\u6578\u5B57,\u662F\u5427? "
  - "\u662F,\u4E00\u5B9A\u8981\u5305\u96D9\u6578,\u800C\u4E14\u4E0D\u53EF\u4EE5\u6709\u300C\u56DB\u300D\u9019\u500B\u6578\u5B57\u3002"
  - "\u6211\u65E9\u5C31\u77E5\u9053\u4E86,\u5728\u81FA\u7063,\u300C\u56DB\u300D\u4E0D\u662F\u5E78\u904B\u7684\u6578\u5B57\u3002\u81FA\u7063\u4EBA\u7D50\u5A5A\u7684\u6642\u5019\u9084\u6709\u54EA\u4E9B\u7FD2\u4FD7\u5462?"
  - "\u5F9E\u53E4\u4EE3\u8D77,\u7D50\u5A5A\u7684\u7FD2\u4FD7\u5C31\u975E\u5E38\u8907\u96DC,\u6539\u5929\u6211\u518D\u8A73\u7D30\u5730\u7D66\u4F60\u4ECB\u7D39\u3002 "
  - "\u6211\u7D93\u904E\u4E00\u5BB6\u5E97,\u770B\u5230\u5F88\u591A\u7D50\u5A5A\u7167\u7247,\u5927\u90E8\u5206\u7A7F\u8457\u897F\u5F0F\u79AE\u670D,\u81FA\u7063\u4EBA\u73FE\u5728\u4E0D\u559C\u6B61\u50B3\u7D71\u65B9\u5F0F\u4E86\u55CE?"
  - "\u6709\u4E9B\u5BB6\u5EAD\u9084\u662F\u91CD\u8996\u50B3\u7D71\u7684,\u4F46\u662F\u6642\u4EE3\u4E0D\u540C\u4E86,\u9019\u4E9B\u50B3\u7D71\u7FD2\u4FD7\u4E5F\u8B8A\u5F97\u8D8A\u4F86\u8D8A\u7C21\u55AE\u3002\u5C24\u5176\u662F\u5E74\u8F15\u4EBA,\u4E0D\u592A\u5728\u4E4E\u50B3\u7D71\u7FD2\u4FD7\u4E86\u3002"
  - "\u4F60\u770B,\u9EC3\u5C0F\u59D0\u7A7F\u4E0A\u65B0\u5A18\u79AE\u670D\u597D\u6F02\u4EAE,\u65B0\u90CE\u4E5F\u5F88\u5E25\u3002\u9023\u540C\u4E8B\u5011\u90FD\u7A7F\u5F97\u8DDF\u5E73\u5E38\u4E0D\u592A\u4E00\u6A23,\u6211\u5E7E\u4E4E\u8A8D\u4E0D\u51FA\u4F86\u662F\u8AB0\u4E86\u3002"
  - "\u53C3\u52A0\u5A5A\u79AE\u4E0D\u53EF\u4EE5\u592A\u96A8\u4FBF,\u6211\u5011\u90FD\u6703\u6253\u626E\u5F97\u6B63\u5F0F\u4E00\u9EDE\u3002"
  - "\u6C92\u60F3\u5230\u81FA\u7063\u7684\u5A5A\u79AE\u9019\u9EBC\u71B1\u9B27,\u70BA\u4EC0\u9EBC\u96D9\u65B9\u7684\u7236\u6BCD\u8DDF\u65B0\u90CE\u65B0\u5A18\u8981\u4F86\u656C\u9152?"
  - "\u656C\u9152\u662F\u4E3B\u4EBA\u5C0D\u5927\u5BB6\u8868\u793A\u611F\u8B1D,\u5BA2\u4EBA\u4E5F\u53EF\u4EE5\u5728\u9019\u500B\u6642\u5019\u795D\u798F\u4ED6\u5011\u3002 "
  - "\u6211\u5011\u5C31\u4E00\u8D77\u795D\u798F\u4ED6\u5011\u300C\u767E\u5E74\u597D\u5408,\u65E9\u751F\u8CB4\u5B50\u300F\u5427!
    \u3002"
